# 统一换行符，避免在 Windows 上出现"整个文件都改了"的假 diff
* text=auto eol=lf

# Windows 脚本保持 CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不要做换行符转换
*.png binary
*.gif binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.exe binary
*.dll binary
*.ttf binary
*.woff binary
*.woff2 binary
